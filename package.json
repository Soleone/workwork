{
  "name": "@soleone/workwork",
  "version": "0.1.1",
  "description": "Find agent work across your repos, sorted by how much human attention it needs.",
  "keywords": [
    "agents",
    "cli",
    "code-quality",
    "coding-agent",
    "maintenance",
    "pull-requests"
  ],
  "homepage": "https://github.com/Soleone/workwork#readme",
  "bugs": "https://github.com/Soleone/workwork/issues",
  "license": "MIT",
  "author": "Soleone",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soleone/workwork.git"
  },
  "bin": {
    "workwork": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "plays",
    "prompts"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "check": "vp check",
    "release": "release-it",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^26.6.5",
    "knip": "^6.45.1",
    "release-it": "^21.1.2",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
