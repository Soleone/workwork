{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "hooks": {
    "before:init": "vp check && vp test run && pnpm exec knip"
  },
  "git": {
    "requireBranch": "main",
    "commitMessage": "chore(release): v${version}",
    "tagName": "v${version}"
  },
  "npm": {
    "skipChecks": true,
    "versionArgs": ["--force"],
    "publishPackageManager": "pnpm",
    "publishArgs": ["--no-git-checks"]
  },
  "github": {
    "release": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "conventionalcommits"
      },
      "infile": "CHANGELOG.md",
      "header": "# Changelog",
      "ignoreRecommendedBump": true
    }
  }
}
